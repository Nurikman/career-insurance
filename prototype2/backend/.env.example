OPENAI_API_KEY=
# Optional
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none
# Production (Railway)
# DATA_DIR=/data                                  # mount a Railway volume here so users/reports survive redeploys
# ALLOWED_ORIGINS=https://your-app.vercel.app     # only needed if the frontend calls the API directly (no Vercel rewrite)
# CROSS_SITE_COOKIES=1                            # only with direct cross-site calls (sets SameSite=None; Secure)
